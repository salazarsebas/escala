# Public site URL, used for metadata/OG tags and the sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stellar network: "testnet" (default, used for the hackathon) or "mainnet".
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Cavos (social login -> embedded Stellar wallet).
# Get an App ID at https://cavos.xyz (Cavos console -> create app -> enable Stellar).
NEXT_PUBLIC_CAVOS_APP_ID=

# Trustless Work (Stellar/Soroban escrow API).
# Request a testnet API key at https://docs.trustlesswork.com/trustless-work/introduction/developer-resources/request-api-key
NEXT_PUBLIC_TW_API_KEY=

# Optional: override the USDC issuer used for trustlines/escrows.
# Defaults to Circle's canonical testnet/mainnet USDC issuer for the selected network.
NEXT_PUBLIC_USDC_ISSUER=
